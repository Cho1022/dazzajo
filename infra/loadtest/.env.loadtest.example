# Immutable ECR image URI. Replace the account, region, repository, and tag.
LOADTEST_WAS_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/buildgraph-api:replace-with-git-sha

# Required RDS PostgreSQL connection.
SPRING_DATASOURCE_URL=jdbc:postgresql://replace-with-rds-endpoint:5432/buildgraph
SPRING_DATASOURCE_USERNAME=replace-with-rds-username
SPRING_DATASOURCE_PASSWORD=replace-with-rds-password

# Required authentication and browser origin settings.
BUILDGRAPH_AUTH_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
BUILDGRAPH_CORS_ALLOWED_ORIGINS=https://replace-with-loadtest-origin.example.com

# Support-chat WebSocket ticket lifetime. This preserves the current default.
SUPPORT_CHAT_WS_TICKET_TTL_SECONDS=60

# The support-chat load-test WAS does not consume Redis or RabbitMQ.
SPRING_RABBITMQ_LISTENER_SIMPLE_AUTO_STARTUP=false
AGENT_WORKER_ENABLED=false
PART_PRICE_REFRESH_WORKER_ENABLED=false
RECOMMENDATION_EVENTS_WORKER_ENABLED=false

# Keep unrelated jobs and external calls out of the measurement window.
BUILDGRAPH_SCHEDULING_ENABLED=false
BUILDGRAPH_HOME_CACHE_PREWARM_ENABLED=false
BUILDGRAPH_AUTH_REFRESH_TOKEN_CLEANUP_ENABLED=false
BUILDGRAPH_AUTH_REFRESH_TOKEN_CLEANUP_RUN_ON_STARTUP=false
PART_PRICE_REFRESH_ENABLED=false
PART_DANAWA_REFRESH_ENABLED=false
PART_DANAWA_TREND_REFRESH_ENABLED=false
PART_MANUFACTURER_RELEASE_INTAKE_ENABLED=false
RAG_VECTOR_ENABLED=false
RAG_VECTOR_REQUIREMENT_PARSE_ENABLED=false
RAG_VECTOR_BUILD_RECOMMEND_ENABLED=false
RAG_VECTOR_AS_ANALYZE_ENABLED=false
RAG_VECTOR_PUBLIC_SEARCH_ENABLED=false
RAG_EMBEDDING_BACKFILL_ON_STARTUP=false
BUILD_CHAT_CACHE_ENABLED=false
BUILD_CHAT_CACHE_PREWARM_ENABLED=false
BUILD_CHAT_SEMANTIC_CACHE_ENABLED=false
BUILD_CHAT_TIER_SNAPSHOT_ENABLED=false
RECOMMENDATION_RERANKER_ENABLED=false
RECOMMENDATION_RERANKER_SHADOW_ENABLED=false
RECOMMENDATION_AUTO_RETRAIN_ENABLED=false
RECOMMENDATION_DRIFT_ENABLED=false
RECOMMENDATION_DRIFT_RETRAIN_ON_SEVERE=false

# Intentionally empty: the support-chat load test must not call external providers.
OPENAI_API_KEY=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
